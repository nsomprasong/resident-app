}

model AuditLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorEmployeeId String?   @map("actor_employee_id") @db.Uuid
  actorAuthUserId String?   @map("actor_auth_user_id") @db.Uuid
  action          String
  entityType      String    @map("entity_type")
  entityId        String?   @map("entity_id")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  actorEmployee   Employee? @relation(fields: [actorEmployeeId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([actorEmployeeId, createdAt])
  @@map("audit_logs")
}
