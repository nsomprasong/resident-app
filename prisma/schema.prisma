generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

enum RaftStatus {
  AVAILABLE
  MAINTENANCE
}

enum InspectionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum InspectionItemType {
  MINIBAR
  DAMAGE
  STAIN
  MISSING
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  AWAITING_PAYMENT
  PENDING_VERIFICATION
  VERIFIED
  CANCELLED
  REJECTED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  PROMPTPAY
  PROMPTPAY_QR
  TRANSFER
  CARD
  ROOM_CHARGE
}

enum PromptPayIdType {
  PHONE
  NATIONAL_ID_OR_TAX_ID
  EWALLET
}

enum PaymentPurpose {
  DEPOSIT
  PARTIAL
  FULL
  OTHER
}

enum ChargeType {
  ROOM
  RAFT
  FOOD
  MINIBAR
  DAMAGE
  CLEANING
  OTHER
  SUPERMARKET
}

enum EmploymentType {
  DAILY
  MONTHLY
}

enum EmployeeHrStatus {
  ACTIVE
  PROBATION
  SUSPENDED
  RESIGNED
  TERMINATED
  ARCHIVED
}

model Zone {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  rooms     Room[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("zones")
}

model RoomType {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  capacity    Int      @default(2)
  bedType     String?  @map("bed_type")
  isActive    Boolean  @default(true) @map("is_active")
  rooms       Room[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("room_types")
}

model Room {
  id           String        @id @default(uuid()) @db.Uuid
  number       String        @unique
  floor        Int?
  status       RoomStatus    @default(AVAILABLE)
  zoneId       String        @map("zone_id") @db.Uuid
  roomTypeId   String        @map("room_type_id") @db.Uuid
  zone         Zone          @relation(fields: [zoneId], references: [id])
  roomType     RoomType      @relation(fields: [roomTypeId], references: [id])
  bookingRooms BookingRoom[]
  orders       Order[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([zoneId, status])
  @@map("rooms")
}

model Raft {
  id           String        @id @default(uuid()) @db.Uuid
  number       String        @unique
  name         String
  capacity     Int           @default(10)
  basePrice    Decimal       @map("base_price") @db.Decimal(10, 2)
  status       RaftStatus    @default(AVAILABLE)
  bookingRafts BookingRaft[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@map("rafts")
}

model Guest {
  id        String    @id @default(uuid()) @db.Uuid
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  phone     String?
  email     String?
  idNumber  String?   @map("id_number")
  bookings  Booking[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([phone])
  @@map("guests")
}

model TourGroup {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  contactName String    @map("contact_name")
  phone       String
  bookings    Booking[]
  foodSet    TourGroupFoodSet?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("tour_groups")
}

model Booking {
  id             String          @id @default(uuid()) @db.Uuid
  reference      String          @unique
  status         BookingStatus   @default(PENDING)
  checkIn        DateTime        @map("check_in") @db.Date
  checkOut       DateTime        @map("check_out") @db.Date
  guestId        String?         @map("guest_id") @db.Uuid
  tourGroupId    String?         @map("tour_group_id") @db.Uuid
  guest          Guest?          @relation(fields: [guestId], references: [id])
  tourGroup      TourGroup?      @relation(fields: [tourGroupId], references: [id])
  rooms          BookingRoom[]
  rafts          BookingRaft[]
  charges        Charge[]
  payments       Payment[]
  paymentRefunds PaymentRefund[]
  orders         Order[]
  posSales       PosSale[]
  notes          String?
  guestCount     Int?            @map("guest_count")
  pricePerPerson Decimal?        @map("price_per_person") @db.Decimal(10, 2)
  closedAt       DateTime?       @map("closed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([checkIn, checkOut, status])
  @@map("bookings")
}

model BookingRoom {
  id         String          @id @default(uuid()) @db.Uuid
  bookingId  String          @map("booking_id") @db.Uuid
  roomId     String          @map("room_id") @db.Uuid
  rate       Decimal         @db.Decimal(10, 2)
  extraBeds  Int             @default(0) @map("extra_beds")
  isExtra    Boolean         @default(false) @map("is_extra")
  booking    Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room       Room            @relation(fields: [roomId], references: [id])
  inspection RoomInspection?

  @@unique([bookingId, roomId])
  @@index([roomId])
  @@map("booking_rooms")
}

model RoomInspection {
  id            String           @id @default(uuid()) @db.Uuid
  bookingRoomId String           @unique @map("booking_room_id") @db.Uuid
  status        InspectionStatus @default(PENDING)
  notes         String?
  completedAt   DateTime?        @map("completed_at")
  completedById String?          @map("completed_by_id") @db.Uuid
  bookingRoom   BookingRoom      @relation(fields: [bookingRoomId], references: [id], onDelete: Cascade)
  completedBy   Employee?        @relation("RoomInspectionCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  items         InspectionItem[]
  charge        Charge?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@index([completedById])
  @@map("room_inspections")
}

model InspectionItem {
  id           String             @id @default(uuid()) @db.Uuid
  inspectionId String             @map("inspection_id") @db.Uuid
  type         InspectionItemType
  description  String
  quantity     Int                @default(1)
  unitPrice    Decimal            @map("unit_price") @db.Decimal(10, 2)
  catalogId    String?            @map("catalog_id") @db.Uuid
  inspection   RoomInspection     @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  catalog      InspectionCatalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now()) @map("created_at")

  @@map("inspection_items")
}

model InspectionCatalog {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @unique
  type      InspectionItemType
  unitPrice Decimal            @map("unit_price") @db.Decimal(10, 2)
  isActive  Boolean            @default(true) @map("is_active")
  items     InspectionItem[]
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@index([type, isActive])
  @@map("inspection_catalogs")
}

model BookingRaft {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @map("booking_id") @db.Uuid
  raftId    String  @map("raft_id") @db.Uuid
  rate      Decimal @db.Decimal(10, 2)
  isExtra   Boolean @default(false) @map("is_extra")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raft      Raft    @relation(fields: [raftId], references: [id])

  @@unique([bookingId, raftId])
  @@index([raftId])
  @@map("booking_rafts")
}

model FoodCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([isActive, name])
  @@map("food_categories")
}

model ProductType {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String    @unique
  requiresFoodCategory Boolean   @default(false) @map("requires_food_category")
  isActive             Boolean   @default(true) @map("is_active")
  products             Product[]
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([isActive, name])
  @@map("product_types")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  price       Decimal       @db.Decimal(10, 2)
  typeId      String        @map("type_id") @db.Uuid
  type        ProductType   @relation(fields: [typeId], references: [id])
  categoryId  String?       @map("category_id") @db.Uuid
  category    FoodCategory? @relation(fields: [categoryId], references: [id])
  isMinibar   Boolean       @default(false) @map("is_minibar")
  imageUrl    String?       @map("image_url")
  isActive    Boolean       @default(true) @map("is_active")
  orderItems  OrderItem[]
  foodSetItems FoodSetItem[]
  tourGroupFoodSetItems TourGroupFoodSetItem[]
  optionGroups ProductOptionGroup[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([typeId, isActive])
  @@index([isMinibar, isActive])
  @@index([typeId, categoryId, isActive])
  @@map("products")
}

model ProductOptionGroup {
  id         String          @id @default(uuid()) @db.Uuid
  productId  String          @map("product_id") @db.Uuid
  name       String
  isRequired Boolean         @default(true) @map("is_required")
  sortOrder  Int             @default(0) @map("sort_order")
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options    ProductOption[]
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@unique([productId, name])
  @@index([productId, sortOrder])
  @@map("product_option_groups")
}

model ProductOption {
  id        String             @id @default(uuid()) @db.Uuid
  groupId   String             @map("group_id") @db.Uuid
  label     String
  sortOrder Int                @default(0) @map("sort_order")
  isActive  Boolean            @default(true) @map("is_active")
  group     ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@unique([groupId, label])
  @@index([groupId, sortOrder])
  @@map("product_options")
}

model FoodSet {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @unique
  description String?
  isActive    Boolean       @default(true) @map("is_active")
  items       FoodSetItem[]
  tourGroupSets TourGroupFoodSet[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([isActive, name])
  @@map("food_sets")
}

model FoodSetItem {
  id             String  @id @default(uuid()) @db.Uuid
  foodSetId      String  @map("food_set_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  quantity       Int     @default(1)
  sortOrder      Int     @default(0) @map("sort_order")
  requireOptions Boolean @default(false) @map("require_options")
  foodSet        FoodSet @relation(fields: [foodSetId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([foodSetId, productId])
  @@index([productId])
  @@index([foodSetId, sortOrder])
  @@map("food_set_items")
}

model TourGroupFoodSet {
  id             String                 @id @default(uuid()) @db.Uuid
  tourGroupId    String                 @unique @map("tour_group_id") @db.Uuid
  sourceFoodSetId String?               @map("source_food_set_id") @db.Uuid
  name           String
  tourGroup      TourGroup              @relation(fields: [tourGroupId], references: [id], onDelete: Cascade)
  sourceFoodSet  FoodSet?               @relation(fields: [sourceFoodSetId], references: [id], onDelete: SetNull)
  items          TourGroupFoodSetItem[]
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@index([sourceFoodSetId])
  @@map("tour_group_food_sets")
}

model TourGroupFoodSetItem {
  id                 String           @id @default(uuid()) @db.Uuid
  tourGroupFoodSetId String           @map("tour_group_food_set_id") @db.Uuid
  productId          String           @map("product_id") @db.Uuid
  quantity           Int              @default(1)
  isExtra            Boolean          @default(false) @map("is_extra")
  optionNote         String?          @map("option_note")
  tourGroupFoodSet   TourGroupFoodSet @relation(fields: [tourGroupFoodSetId], references: [id], onDelete: Cascade)
  product            Product          @relation(fields: [productId], references: [id])
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@unique([tourGroupFoodSetId, productId])
  @@index([productId])
  @@map("tour_group_food_set_items")
}

model Order {
  id        String      @id @default(uuid()) @db.Uuid
  number    String      @unique
  status    OrderStatus @default(PENDING)
  bookingId String?     @map("booking_id") @db.Uuid
  roomId    String?     @map("room_id") @db.Uuid
  booking   Booking?    @relation(fields: [bookingId], references: [id])
  room      Room?       @relation(fields: [roomId], references: [id])
  items     OrderItem[]
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int     @default(1)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  note      String?
  isExtra   Boolean @default(true) @map("is_extra")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Charge {
  id           String          @id @default(uuid()) @db.Uuid
  bookingId    String          @map("booking_id") @db.Uuid
  inspectionId String?         @unique @map("inspection_id") @db.Uuid
  type         ChargeType
  description  String
  amount       Decimal         @db.Decimal(10, 2)
  sourceType   String?         @map("source_type")
  sourceId     String?         @map("source_id")
  booking      Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  inspection   RoomInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now()) @map("created_at")

  @@unique([sourceType, sourceId])
  @@index([bookingId, type])
  @@map("charges")
}

model Payment {
  id                           String                 @id @default(uuid()) @db.Uuid
  paymentNumber                String?                @unique @map("payment_number")
  bookingId                    String                 @map("booking_id") @db.Uuid
  amount                       Decimal                @db.Decimal(10, 2)
  currency                     String                 @default("THB")
  method                       PaymentMethod
  purpose                      PaymentPurpose?
  status                       PaymentStatus          @default(PENDING)
  reference                    String?
  channelId                    String?                @map("channel_id") @db.Uuid
  promptpayAccountId           String?                @map("promptpay_account_id") @db.Uuid
  promptpayAccountNameSnapshot String?                @map("promptpay_account_name_snapshot")
  promptpayIdentifierMasked    String?                @map("promptpay_identifier_masked")
  paidAt                       DateTime?              @map("paid_at")
  submittedAt                  DateTime?              @map("submitted_at")
  verifiedAt                   DateTime?              @map("verified_at")
  verifiedById                 String?                @map("verified_by_id") @db.Uuid
  createdById                  String?                @map("created_by_id") @db.Uuid
  slipStorageBucket            String?                @map("slip_storage_bucket")
  slipStoragePath              String?                @map("slip_storage_path")
  slipFileName                 String?                @map("slip_file_name")
  slipContentType              String?                @map("slip_content_type")
  slipSizeBytes                Int?                   @map("slip_size_bytes")
  note                         String?
  cancelledAt                  DateTime?              @map("cancelled_at")
  cancelReason                 String?                @map("cancel_reason")
  booking                      Booking                @relation(fields: [bookingId], references: [id])
  channel                      PaymentChannel?        @relation(fields: [channelId], references: [id], onDelete: SetNull)
  promptpayAccount             PromptPayAccount?      @relation(fields: [promptpayAccountId], references: [id], onDelete: Restrict)
  verifiedBy                   Employee?              @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdBy                    Employee?              @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  statusHistory                PaymentStatusHistory[]
  refunds                      PaymentRefund[]
  createdAt                    DateTime               @default(now()) @map("created_at")
  updatedAt                    DateTime               @updatedAt @map("updated_at")

  @@index([bookingId, status])
  @@index([status, createdAt])
  @@index([promptpayAccountId])
  @@map("payments")
}

model PaymentChannel {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique
  method    PaymentMethod
  isActive  Boolean       @default(true) @map("is_active")
  payments  Payment[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("payment_channels")
}

model PromptPayAccount {
  id          String          @id @default(uuid()) @db.Uuid
  displayName String          @map("display_name")
  idType      PromptPayIdType @map("id_type")
  identifier  String
  accountName String          @map("account_name")
  bankName    String?         @map("bank_name")
  isActive    Boolean         @default(true) @map("is_active")
  isPrimary   Boolean         @default(false) @map("is_primary")
  notes       String?
  createdById String?         @map("created_by_id") @db.Uuid
  updatedById String?         @map("updated_by_id") @db.Uuid
  createdBy   Employee?       @relation("PromptPayAccountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   Employee?       @relation("PromptPayAccountUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  payments    Payment[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([isActive, isPrimary])
  @@index([idType])
  @@map("promptpay_accounts")
}

model PaymentStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  paymentId  String         @map("payment_id") @db.Uuid
  fromStatus PaymentStatus? @map("from_status")
  toStatus   PaymentStatus  @map("to_status")
  note       String?
  actorId    String?        @map("actor_id") @db.Uuid
  payment    Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor      Employee?      @relation("PaymentStatusActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([paymentId, createdAt])
  @@map("payment_status_history")
}

model PaymentRefund {
  id          String    @id @default(uuid()) @db.Uuid
  paymentId   String    @map("payment_id") @db.Uuid
  bookingId   String    @map("booking_id") @db.Uuid
  amount      Decimal   @db.Decimal(10, 2)
  reason      String?
  createdById String?   @map("created_by_id") @db.Uuid
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdBy   Employee? @relation("PaymentRefundCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([paymentId])
  @@index([bookingId, createdAt])
  @@map("payment_refunds")
}

model Department {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  isActive  Boolean    @default(true) @map("is_active")
  positions Position[]
  employees Employee[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("departments")
}

model Position {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isActive     Boolean     @default(true) @map("is_active")
  employees    Employee[]
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@unique([departmentId, name])
  @@index([isActive])
  @@map("positions")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique
  displayName String           @map("display_name")
  isActive    Boolean          @default(true) @map("is_active")
  permissions RolePermission[]
  employees   Employee[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Employee {
  id                        String                 @id @default(uuid()) @db.Uuid
  authUserId                String?                @unique @map("auth_user_id") @db.Uuid
  email                     String?                @unique
  username                  String?                @unique
  name                      String
  employeeCode              String?                @unique @map("employee_code")
  firstName                 String?                @map("first_name")
  lastName                  String?                @map("last_name")
  nickname                  String?
  photoUrl                  String?                @map("photo_url")
  birthDate                 DateTime?              @map("birth_date") @db.Date
  nationalId                String?                @map("national_id")
  phone                     String?                @unique
  address                   String?
  emergencyContactName      String?                @map("emergency_contact_name")
  emergencyContactPhone     String?                @map("emergency_contact_phone")
  employmentType            EmploymentType         @default(MONTHLY) @map("employment_type")
  departmentId              String?                @map("department_id") @db.Uuid
  department                Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
