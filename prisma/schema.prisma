  WEEKLY
  SEMI_MONTHLY
  MONTHLY
  CUSTOM
}

enum PayrollPeriodStatus {
  DRAFT
  CALCULATED
  REVIEWED
  APPROVED
  PAID
}

model PayrollPeriod {
  id             String              @id @default(uuid()) @db.Uuid
  name           String
  periodType     PayrollPeriodType   @map("period_type")
  periodStart    DateTime            @map("period_start") @db.Date
  periodEnd      DateTime            @map("period_end") @db.Date
  status         PayrollPeriodStatus @default(DRAFT)
  lockedAt       DateTime?           @map("locked_at")
  calculatedAt   DateTime?           @map("calculated_at")
  reviewedAt     DateTime?           @map("reviewed_at")
  approvedAt     DateTime?           @map("approved_at")
  paidAt         DateTime?           @map("paid_at")
  calculatedById String?             @map("calculated_by_id") @db.Uuid
  reviewedById   String?             @map("reviewed_by_id") @db.Uuid
  approvedById   String?             @map("approved_by_id") @db.Uuid
  paidById       String?             @map("paid_by_id") @db.Uuid
  notes          String?
  calculatedBy   Employee?           @relation("PayrollPeriodCalculator", fields: [calculatedById], references: [id], onDelete: SetNull)
  reviewedBy     Employee?           @relation("PayrollPeriodReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy     Employee?           @relation("PayrollPeriodApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  paidBy         Employee?           @relation("PayrollPeriodPayer", fields: [paidById], references: [id], onDelete: SetNull)
  entries        PayrollEntry[]
  adjustments    PayrollAdjustment[]
  payslips       PayrollPayslip[]
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([periodStart, periodEnd])
  @@index([status, periodStart])
  @@map("payroll_periods")
}

enum PayrollAdjustmentType {
  BONUS
  DEDUCTION
  ADVANCE
  OTHER_EARNING
}

model PayrollEntry {
  id                   String              @id @default(uuid()) @db.Uuid
  periodId             String              @map("period_id") @db.Uuid
  employeeId           String              @map("employee_id") @db.Uuid
  employmentType       EmploymentType      @map("employment_type")
  basePay              Decimal             @default(0) @map("base_pay") @db.Decimal(12, 2)
  otPay                Decimal             @default(0) @map("ot_pay") @db.Decimal(12, 2)
  holidayPay           Decimal             @default(0) @map("holiday_pay") @db.Decimal(12, 2)
  allowances           Decimal             @default(0) @db.Decimal(12, 2)
  bonuses              Decimal             @default(0) @db.Decimal(12, 2)
  deductions           Decimal             @default(0) @db.Decimal(12, 2)
  advances             Decimal             @default(0) @db.Decimal(12, 2)
  unpaidLeaveDeduction Decimal             @default(0) @map("unpaid_leave_deduction") @db.Decimal(12, 2)
  absenceDeduction     Decimal             @default(0) @map("absence_deduction") @db.Decimal(12, 2)
  lateDeduction        Decimal             @default(0) @map("late_deduction") @db.Decimal(12, 2)
  grossPay             Decimal             @default(0) @map("gross_pay") @db.Decimal(12, 2)
  netPay               Decimal             @default(0) @map("net_pay") @db.Decimal(12, 2)
  workedMinutes        Int                 @default(0) @map("worked_minutes")
  otMinutes            Int                 @default(0) @map("ot_minutes")
  absentDays           Decimal             @default(0) @map("absent_days") @db.Decimal(8, 2)
  unpaidLeaveDays      Decimal             @default(0) @map("unpaid_leave_days") @db.Decimal(8, 2)
  lateMinutes          Int                 @default(0) @map("late_minutes")
  /** Rates frozen at calculate time (additive Phase 21). */
  hourlyRateSnapshot   Decimal?            @map("hourly_rate_snapshot") @db.Decimal(12, 2)
  otHourlyRateSnapshot Decimal?            @map("ot_hourly_rate_snapshot") @db.Decimal(12, 2)
  otMultiplierSnapshot Decimal?            @map("ot_multiplier_snapshot") @db.Decimal(8, 4)
  dailyRateSnapshot    Decimal?            @map("daily_rate_snapshot") @db.Decimal(12, 2)
  monthlySalarySnapshot Decimal?           @map("monthly_salary_snapshot") @db.Decimal(12, 2)
  replacementShiftCount Int                @default(0) @map("replacement_shift_count")
  doubleShiftCount     Int                 @default(0) @map("double_shift_count")
  notes                String?
  period               PayrollPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee             Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  adjustments          PayrollAdjustment[]
  payslip              PayrollPayslip?
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@unique([periodId, employeeId])
  @@index([employeeId, periodId])
  @@map("payroll_entries")
}

model PayrollAdjustment {
  id          String                @id @default(uuid()) @db.Uuid
  periodId    String                @map("period_id") @db.Uuid
  entryId     String?               @map("entry_id") @db.Uuid
  employeeId  String                @map("employee_id") @db.Uuid
  type        PayrollAdjustmentType
  amount      Decimal               @db.Decimal(12, 2)
  reason      String
  createdById String                @map("created_by_id") @db.Uuid
  period      PayrollPeriod         @relation(fields: [periodId], references: [id], onDelete: Cascade)
  entry       PayrollEntry?         @relation(fields: [entryId], references: [id], onDelete: SetNull)
  employee    Employee              @relation("PayrollAdjustmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy   Employee              @relation("PayrollAdjustmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@index([periodId, employeeId])
  @@index([entryId])
  @@map("payroll_adjustments")
}

model PayrollPayslip {
  id         String        @id @default(uuid()) @db.Uuid
  periodId   String        @map("period_id") @db.Uuid
  entryId    String        @unique @map("entry_id") @db.Uuid
  employeeId String        @map("employee_id") @db.Uuid
  payload    Json
  issuedAt   DateTime      @default(now()) @map("issued_at")
  period     PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  entry      PayrollEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([periodId, employeeId])
  @@map("payroll_payslips")
}

enum EmployeeDocumentType {
  CONTRACT
  NATIONAL_ID
  BANK_ACCOUNT
  CERTIFICATE
  LEAVE_DOCUMENT
  OTHER
}

model EmployeeDocument {
  id            String               @id @default(uuid()) @db.Uuid
  employeeId    String               @map("employee_id") @db.Uuid
  documentType  EmployeeDocumentType @map("document_type")
  title         String
  fileName      String               @map("file_name")
  contentType   String               @map("content_type")
  sizeBytes     Int                  @map("size_bytes")
  storageBucket String               @map("storage_bucket")
  storagePath   String               @map("storage_path")
  issuedAt      DateTime?            @map("issued_at") @db.Date
  expiresAt     DateTime?            @map("expires_at") @db.Date
  notes         String?
  uploadedById  String               @map("uploaded_by_id") @db.Uuid
  employee      Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy    Employee             @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([employeeId, documentType])
  @@index([expiresAt])
  @@index([storageBucket, storagePath])
  @@map("employee_documents")
}

model WorkShift {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  startsAt   DateTime @map("starts_at")
  endsAt     DateTime @map("ends_at")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startsAt])
  @@map("work_shifts")
}

model AuditLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorEmployeeId String?   @map("actor_employee_id") @db.Uuid
  actorAuthUserId String?   @map("actor_auth_user_id") @db.Uuid
  action          String
  entityType      String    @map("entity_type")
  entityId        String?   @map("entity_id")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  actorEmployee   Employee? @relation(fields: [actorEmployeeId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([actorEmployeeId, createdAt])
  @@map("audit_logs")
}

// --- Phase 20: Supermarket POS (separate from food Product catalog) ---

enum PosStockMovementType {
  RECEIVE
  ADJUST_IN
  ADJUST_OUT
  SALE
  REFUND_RESTOCK
  DAMAGE
  LOSS
  EXPIRED
  COUNT_ADJUST
}

enum PosShiftStatus {
  OPEN
  CLOSED
  APPROVED
}

enum PosCashMovementType {
  IN
  OUT
}

enum PosSaleStatus {
  COMPLETED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PosPaymentMethod {
  CASH
  PROMPTPAY
  TRANSFER
  ROOM_CHARGE
  TOUR_CHARGE
}

enum PosHoldStatus {
  OPEN
  RESUMED
  CANCELLED
}

enum PosAccountingEntryType {
  CASH_REVENUE
  PROMPTPAY_REVENUE
  TRANSFER_REVENUE
  ROOM_RECEIVABLE
  TOUR_RECEIVABLE
  DISCOUNT
  REFUND
  NET_SALES
  COGS
  GROSS_PROFIT
  CASH_OVER_SHORT
}

model PosCategory {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  sortOrder Int          @default(0) @map("sort_order")
  isActive  Boolean      @default(true) @map("is_active")
  products  PosProduct[]
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("pos_categories")
}

model PosProduct {
  id                String              @id @default(uuid()) @db.Uuid
  sku               String              @unique
  barcode           String?             @unique
  name              String
  categoryId        String              @map("category_id") @db.Uuid
  category          PosCategory         @relation(fields: [categoryId], references: [id])
  unit              String              @default("ชิ้น")
  costPrice         Decimal             @map("cost_price") @db.Decimal(12, 2)
  sellPrice         Decimal             @map("sell_price") @db.Decimal(12, 2)
  quantityOnHand    Decimal             @default(0) @map("quantity_on_hand") @db.Decimal(12, 3)
  lowStockThreshold Decimal             @default(0) @map("low_stock_threshold") @db.Decimal(12, 3)
  imageUrl          String?             @map("image_url")
  isActive          Boolean             @default(true) @map("is_active")
  stockMovements    PosStockMovement[]
  stockCountItems   PosStockCountItem[]
  saleItems         PosSaleItem[]
  holdItems         PosHoldItem[]
  refundItems       PosRefundItem[]
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([categoryId, isActive])
  @@index([name])
  @@index([isActive, quantityOnHand])
  @@map("pos_products")
}

model PosStockMovement {
  id              String               @id @default(uuid()) @db.Uuid
  productId       String               @map("product_id") @db.Uuid
  product         PosProduct           @relation(fields: [productId], references: [id])
  type            PosStockMovementType
  quantityDelta   Decimal              @map("quantity_delta") @db.Decimal(12, 3)
  quantityBefore  Decimal              @map("quantity_before") @db.Decimal(12, 3)
  quantityAfter   Decimal              @map("quantity_after") @db.Decimal(12, 3)
  documentNumber  String?              @map("document_number")
  reason          String?
  referenceType   String?              @map("reference_type")
  referenceId     String?              @map("reference_id")
  actorEmployeeId String               @map("actor_employee_id") @db.Uuid
  actor           Employee             @relation(fields: [actorEmployeeId], references: [id])
  occurredAt      DateTime             @default(now()) @map("occurred_at")
  createdAt       DateTime             @default(now()) @map("created_at")

  @@index([productId, occurredAt])
  @@index([referenceType, referenceId])
  @@index([type, occurredAt])
  @@map("pos_stock_movements")
}

model PosStockCount {
  id              String              @id @default(uuid()) @db.Uuid
  documentNumber  String              @unique @map("document_number")
  note            String?
  countedAt       DateTime            @default(now()) @map("counted_at")
  actorEmployeeId String              @map("actor_employee_id") @db.Uuid
  actor           Employee            @relation(fields: [actorEmployeeId], references: [id])
  items           PosStockCountItem[]
  createdAt       DateTime            @default(now()) @map("created_at")

  @@map("pos_stock_counts")
}

model PosStockCountItem {
  id              String        @id @default(uuid()) @db.Uuid
  countId         String        @map("count_id") @db.Uuid
  count           PosStockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId       String        @map("product_id") @db.Uuid
  product         PosProduct    @relation(fields: [productId], references: [id])
  systemQuantity  Decimal       @map("system_quantity") @db.Decimal(12, 3)
  countedQuantity Decimal       @map("counted_quantity") @db.Decimal(12, 3)
  variance        Decimal       @db.Decimal(12, 3)

  @@unique([countId, productId])
  @@map("pos_stock_count_items")
}

model PosShift {
  id                 String            @id @default(uuid()) @db.Uuid
  status             PosShiftStatus    @default(OPEN)
  openingFloat       Decimal           @map("opening_float") @db.Decimal(12, 2)
  closingCashCounted Decimal?          @map("closing_cash_counted") @db.Decimal(12, 2)
  expectedCash       Decimal?          @map("expected_cash") @db.Decimal(12, 2)
  cashVariance       Decimal?          @map("cash_variance") @db.Decimal(12, 2)
  openedById         String            @map("opened_by_id") @db.Uuid
  openedBy           Employee          @relation("PosShiftOpener", fields: [openedById], references: [id])
  closedById         String?           @map("closed_by_id") @db.Uuid
  closedBy           Employee?         @relation("PosShiftCloser", fields: [closedById], references: [id])
  approvedById       String?           @map("approved_by_id") @db.Uuid
  approvedBy         Employee?         @relation("PosShiftApprover", fields: [approvedById], references: [id])
  openedAt           DateTime          @default(now()) @map("opened_at")
  closedAt           DateTime?         @map("closed_at")
  approvedAt         DateTime?         @map("approved_at")
  note               String?
  cashMovements      PosCashMovement[]
  sales              PosSale[]
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([status, openedAt])
  @@index([openedById, status])
  @@map("pos_shifts")
}

model PosCashMovement {
  id              String              @id @default(uuid()) @db.Uuid
  shiftId         String              @map("shift_id") @db.Uuid
  shift           PosShift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type            PosCashMovementType
  amount          Decimal             @db.Decimal(12, 2)
  reason          String
  actorEmployeeId String              @map("actor_employee_id") @db.Uuid
  actor           Employee            @relation(fields: [actorEmployeeId], references: [id])
  createdAt       DateTime            @default(now()) @map("created_at")

  @@index([shiftId, createdAt])
  @@map("pos_cash_movements")
}

model PosSale {
  id                String               @id @default(uuid()) @db.Uuid
  receiptNumber     String               @unique @map("receipt_number")
  idempotencyKey    String               @unique @map("idempotency_key")
  status            PosSaleStatus        @default(COMPLETED)
  shiftId           String               @map("shift_id") @db.Uuid
  shift             PosShift             @relation(fields: [shiftId], references: [id])
  soldById          String               @map("sold_by_id") @db.Uuid
  soldBy            Employee             @relation("PosSaleSeller", fields: [soldById], references: [id])
  voidedById        String?              @map("voided_by_id") @db.Uuid
  voidedBy          Employee?            @relation("PosSaleVoider", fields: [voidedById], references: [id])
  bookingId         String?              @map("booking_id") @db.Uuid
  booking           Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  subtotal          Decimal              @db.Decimal(12, 2)
  itemDiscountTotal Decimal              @default(0) @map("item_discount_total") @db.Decimal(12, 2)
  billDiscount      Decimal              @default(0) @map("bill_discount") @db.Decimal(12, 2)
  netTotal          Decimal              @map("net_total") @db.Decimal(12, 2)
  costTotal         Decimal              @default(0) @map("cost_total") @db.Decimal(12, 2)
  cashReceived      Decimal?             @map("cash_received") @db.Decimal(12, 2)
  changeGiven       Decimal?             @map("change_given") @db.Decimal(12, 2)
  note              String?
  voidReason        String?              @map("void_reason")
  soldAt            DateTime             @default(now()) @map("sold_at")
  voidedAt          DateTime?            @map("voided_at")
  items             PosSaleItem[]
  payments          PosPayment[]
  refunds           PosRefund[]
  accountingEntries PosAccountingEntry[]
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@index([soldAt, status])
  @@index([shiftId, soldAt])
  @@index([bookingId])
  @@map("pos_sales")
}

model PosSaleItem {
  id          String          @id @default(uuid()) @db.Uuid
  saleId      String          @map("sale_id") @db.Uuid
  sale        PosSale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String          @map("product_id") @db.Uuid
  product     PosProduct      @relation(fields: [productId], references: [id])
  productName String          @map("product_name")
  sku         String
  quantity    Decimal         @db.Decimal(12, 3)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  costPrice   Decimal         @map("cost_price") @db.Decimal(12, 2)
  discount    Decimal         @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal         @map("line_total") @db.Decimal(12, 2)
  refundItems PosRefundItem[]

  @@index([saleId])
  @@index([productId])
  @@map("pos_sale_items")
}

model PosPayment {
  id        String           @id @default(uuid()) @db.Uuid
  saleId    String           @map("sale_id") @db.Uuid
  sale      PosSale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PosPaymentMethod
  amount    Decimal          @db.Decimal(12, 2)
  reference String?
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([saleId])
  @@index([method])
  @@map("pos_payments")
}

model PosHold {
  id           String        @id @default(uuid()) @db.Uuid
  holdNumber   String        @unique @map("hold_number")
  status       PosHoldStatus @default(OPEN)
  shiftId      String?       @map("shift_id") @db.Uuid
  heldById     String        @map("held_by_id") @db.Uuid
  heldBy       Employee      @relation(fields: [heldById], references: [id])
  billDiscount Decimal       @default(0) @map("bill_discount") @db.Decimal(12, 2)
  note         String?
  payload      Json
  items        PosHoldItem[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  resumedAt    DateTime?     @map("resumed_at")

  @@index([status, createdAt])
  @@map("pos_holds")
}

model PosHoldItem {
  id        String     @id @default(uuid()) @db.Uuid
  holdId    String     @map("hold_id") @db.Uuid
  hold      PosHold    @relation(fields: [holdId], references: [id], onDelete: Cascade)
  productId String     @map("product_id") @db.Uuid
  product   PosProduct @relation(fields: [productId], references: [id])
  quantity  Decimal    @db.Decimal(12, 3)
  unitPrice Decimal    @map("unit_price") @db.Decimal(12, 2)
  discount  Decimal    @default(0) @db.Decimal(12, 2)

  @@map("pos_hold_items")
}

model PosRefund {
  id              String           @id @default(uuid()) @db.Uuid
  refundNumber    String           @unique @map("refund_number")
  saleId          String           @map("sale_id") @db.Uuid
  sale            PosSale          @relation(fields: [saleId], references: [id])
  reason          String
  restock         Boolean          @default(true)
  refundTotal     Decimal          @map("refund_total") @db.Decimal(12, 2)
  refundMethod    PosPaymentMethod @map("refund_method")
  actorEmployeeId String           @map("actor_employee_id") @db.Uuid
  actor           Employee         @relation(fields: [actorEmployeeId], references: [id])
  items           PosRefundItem[]
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([saleId, createdAt])
  @@map("pos_refunds")
}

model PosRefundItem {
  id         String      @id @default(uuid()) @db.Uuid
  refundId   String      @map("refund_id") @db.Uuid
  refund     PosRefund   @relation(fields: [refundId], references: [id], onDelete: Cascade)
  saleItemId String      @map("sale_item_id") @db.Uuid
  saleItem   PosSaleItem @relation(fields: [saleItemId], references: [id])
  productId  String      @map("product_id") @db.Uuid
  product    PosProduct  @relation(fields: [productId], references: [id])
  quantity   Decimal     @db.Decimal(12, 3)
  amount     Decimal     @db.Decimal(12, 2)

  @@map("pos_refund_items")
}

model PosSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("pos_settings")
}

model PosAccountingEntry {
  id             String                 @id @default(uuid()) @db.Uuid
  entryType      PosAccountingEntryType @map("entry_type")
  amount         Decimal                @db.Decimal(12, 2)
  occurredAt     DateTime               @map("occurred_at")
  referenceType  String                 @map("reference_type")
  referenceId    String                 @map("reference_id")
  saleId         String?                @map("sale_id") @db.Uuid
  sale           PosSale?               @relation(fields: [saleId], references: [id], onDelete: SetNull)
  description    String
  idempotencyKey String                 @unique @map("idempotency_key")
  createdAt      DateTime               @default(now()) @map("created_at")

  @@index([occurredAt, entryType])
  @@index([referenceType, referenceId])
  @@map("pos_accounting_entries")
}

model PosReceiptSequence {
  id        String   @id @default(uuid()) @db.Uuid
  prefix    String   @unique
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pos_receipt_sequences")
}
